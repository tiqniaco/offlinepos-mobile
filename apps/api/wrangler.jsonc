{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "daftarak-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Daily housekeeping (src/cron/cleanup.ts): old OTP rows / logs / counters / crash reports, stale backups, OCR rows.
  "triggers": { "crons": ["17 2 * * *"] },
  "d1_databases": [
    // Create with: npx wrangler d1 create daftarak — then paste the id here.
    { "binding": "DB", "database_name": "daftarak", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "daftarak-backups" }],
  "vars": {
    "ENVIRONMENT": "development",
    "R2_ACCOUNT_ID": "dev",
    "R2_BUCKET": "daftarak-backups",
    "OTP_PROVIDER": "console",
    "LICENCE_KID": "dev",
    "ADMIN_ORIGIN": "http://localhost:5173",
    "SMSMISR_BASE_URL": "https://smsmisr.com/api/OTP/",
    "SMSMISR_ENVIRONMENT": "2"
  },
  "env": {
    "production": {
      "name": "daftarak-api",
      // Served only on the custom domain (no *.workers.dev address).
      "workers_dev": false,
      "triggers": { "crons": ["17 2 * * *"] },
      "d1_databases": [
        { "binding": "DB", "database_name": "daftarak", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
      ],
      "r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "daftarak-backups" }],
      "vars": {
        // Turns off every test shortcut (fixed OTP code, console SMS provider). Do not change.
        "ENVIRONMENT": "production",
        "R2_ACCOUNT_ID": "<cloudflare-account-id>",
        "R2_BUCKET": "daftarak-backups",
        "OTP_PROVIDER": "smsmisr",
        "LICENCE_KID": "2026-01",
        "ADMIN_ORIGIN": "https://admin.daftarak.app",
        "SMSMISR_BASE_URL": "https://smsmisr.com/api/OTP/",
        "SMSMISR_ENVIRONMENT": "1"
      }
    }
  }
  // Secrets (wrangler secret put …): LICENCE_SIGNING_KEY, ACCESS_TOKEN_SECRET, OTP_PEPPER,
  // BACKUP_WRAP_KEY, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, REVENUECAT_WEBHOOK_SECRET, SMSMISR_USERNAME, SMSMISR_PASSWORD, SMSMISR_SENDER, SMSMISR_TEMPLATE,
  // ANTHROPIC_API_KEY (invoice scans; optional vars OCR_MODEL / OCR_FALLBACK_MODEL).
  // Local dev: put them in .dev.vars (git-ignored). See docs/dev-setup.md.
}
